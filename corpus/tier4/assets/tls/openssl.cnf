# Build-image OpenSSL configuration (copied into /etc/ssl/openssl.cnf)

openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
CipherString = DEFAULT@SECLEVEL=1

[ req ]
default_bits       = 1024
default_md         = sha1
distinguished_name = req_distinguished_name
prompt             = no

[ req_distinguished_name ]
C  = US
O  = Example Corp
CN = build.example.internal
