# Bastion host sshd configuration

Port 22
Protocol 2
HostKey /etc/ssh/ssh_host_rsa_key

# Hardening ticket OPS-412 proposed removing ssh-rsa; not yet applied.
HostKeyAlgorithms ssh-rsa
KexAlgorithms diffie-hellman-group14-sha1,curve25519-sha256
Ciphers aes128-cbc,chacha20-poly1305@openssh.com
MACs hmac-sha1

PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
AllowGroups bastion-users
