# Bastion host sshd configuration

Port 22
Protocol 2
HostKey /etc/ssh/ssh_host_ed25519_key

# Hardening ticket OPS-412 applied: ssh-rsa, group14-sha1, CBC and SHA-1 MACs removed; PQ hybrid KEX first.
HostKeyAlgorithms ssh-ed25519
KexAlgorithms mlkem768x25519-sha256,curve25519-sha256
Ciphers aes256-gcm@openssh.com,chacha20-poly1305@openssh.com
MACs hmac-sha2-512-etm@openssh.com

PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
AllowGroups bastion-users
