{
  "schema": "cbom-testbench libraries 1",
  "notes": "Crypto libraries declared in corpus/deps/. One finding per (manifest, library). 'version' is what the manifest declares (null for a range); 'scope' is direct or transitive (lockfile only). 'pq_capable' says whether that version ships NIST ML-KEM / ML-DSA, and is null where it doesn't apply (password hashing) or wasn't verified. 'status' is set only where a primary source says so. Sources are in the 'sources' block.",
  "sources": {
    "pyca-cryptography": "https://cryptography.io/changelog.html (47.0.0: ML-KEM/ML-DSA with AWS-LC and BoringSSL only; 48.0.0: with OpenSSL 3.5.0+, available in the wheels)",
    "bouncycastle": "https://old.bouncycastle.org/releasenotes.html (1.78: ML-KEM per the FIPS 203 initial public draft) and https://bouncycastle.org/resources/latest-nist-pqc-standards-and-more-bouncy-castle-java-1-79/ (1.79: the finalized ML-KEM, ML-DSA, SLH-DSA); Maven Central: bcprov-jdk15on last release 1.70 (2021-12-01), bcprov-jdk18on from 1.71 (2022-04-06)",
    "circl": "https://github.com/cloudflare/circl/releases (v1.4.0: ML-KEM; v1.5.0: ML-DSA)",
    "crypto-js": "https://app.unpkg.com/crypto-js@4.2.0/files/README.md ('Active development of CryptoJS has been discontinued. This library is no longer maintained.')",
    "openssl": "https://mirror.openssl-library.org/post/2023-09-11-eol-111/ ('OpenSSL 1.1.1 has reached its EOL as of today, 11th September 2023') and https://openssl-library.org/post/2025-04-08-openssl-35-final-release (3.5 adds ML-KEM, ML-DSA and SLH-DSA)"
  },
